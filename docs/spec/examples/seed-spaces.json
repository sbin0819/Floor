  "loungeMessages": [
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "both", "minutesAgo": 4320, "body": "강남점 7층 라운지 커피 머신 새로 들어왔어요 ☕ 라떼도 돼요!" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "member", "minutesAgo": 4300, "body": "오 반가운 소식! 오후에 가 볼게요." },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "test15", "minutesAgo": 2900, "body": "6층 폰부스 6-1 문 손잡이 고쳐졌네요. 고마워요!" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "admin", "minutesAgo": 2880, "body": "네, 어제 수리 끝났어요. 불편한 곳 있으면 여기 남겨 주세요 🙏" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "test19", "minutesAgo": 1500, "body": "💰 주말 코인 리딩방 무료 초대! 선착순 30명, 수익 인증 多. 링크 클릭 👉 bit.ly/free-coin-room" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "designMember", "minutesAgo": 1490, "body": "위 광고 글은 신고했어요. 운영자님 확인 부탁드려요." },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "test13", "minutesAgo": 600, "body": "내일 오리엔테이션 참석하시는 분 손 🙋 끝나고 같이 저녁 어때요?" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "growthAdmin", "minutesAgo": 240, "body": "회의실 6B 에어컨 수리 중이라 6C 쓰고 있어요. 6C는 좀 춥네요 🥶" },
    { "branchId": "15eeb72a-6e7f-57ca-a905-d8797f988992", "authorKey": "admin", "minutesAgo": 230, "body": "6B 수리는 내일까지예요. 담요를 라운지에 비치했어요!" },
    { "branchId": "48d209a7-fccd-5e26-b95d-466afaf62709", "authorKey": "test6", "minutesAgo": 5000, "body": "성수점 2층 S1 모니터, USB-C 케이블 지원되나요?" },
    { "branchId": "48d209a7-fccd-5e26-b95d-466afaf62709", "authorKey": "admin", "minutesAgo": 4980, "body": "네, S1·S2 둘 다 USB-C 케이블 있어요." },
    { "branchId": "48d209a7-fccd-5e26-b95d-466afaf62709", "authorKey": "test20", "minutesAgo": 1200, "body": "3층 공사 소음이 좀 크네요. 언제까지인가요?" },
    { "branchId": "48d209a7-fccd-5e26-b95d-466afaf62709", "authorKey": "admin", "minutesAgo": 1180, "body": "이달 말까지예요. # 공지에 자세히 적어 뒀어요. 양해 부탁드려요 🙏" },
    { "branchId": "30f94644-2de6-54db-93bd-0a1f5ad55cdd", "authorKey": "test10", "minutesAgo": 3000, "body": "홍대점 라운지 처음 왔는데 분위기 좋네요 ☀️" },
    { "branchId": "30f94644-2de6-54db-93bd-0a1f5ad55cdd", "authorKey": "test19", "minutesAgo": 2990, "body": "저도 자주 와요. 2층 창가 자리 추천!" },
    { "branchId": "30f94644-2de6-54db-93bd-0a1f5ad55cdd", "authorKey": "admin", "minutesAgo": 500, "body": "세미나룸 H3 프로젝터 교체 일정은 # 공지에 올렸어요." },
    { "branchId": "34db02c8-7a13-5ca1-aae8-d7bcb74189f4", "authorKey": "test17", "minutesAgo": 2000, "body": "여의도점 11층 세미나룸 빔 밝기 좋아요. 발표 연습하기 딱이네요." },
    { "branchId": "34db02c8-7a13-5ca1-aae8-d7bcb74189f4", "authorKey": "admin", "minutesAgo": 1990, "body": "리허설 예약 환영해요. 마이크도 빌려 드릴 수 있어요 🎤" },
    { "branchId": "bfc43c7c-c340-5a15-99ea-ccd4f4fca60e", "authorKey": "test18", "minutesAgo": 700, "body": "판교점 5층 라운지에 스탠딩 데스크 생겼어요!" },
    { "branchId": "bfc43c7c-c340-5a15-99ea-ccd4f4fca60e", "authorKey": "test8", "minutesAgo": 690, "body": "오 다음 주 밋업 때 써 봐야겠네요." }
  ],
