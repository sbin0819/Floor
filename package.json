    "admin:create": "node --conditions=react-server --import=tsx --env-file-if-exists=.env.local scripts/admin-create.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
