# Neon PostgreSQL 연결 문자열이에요. 빌드와 테스트에는 필요하지 않아요.
DATABASE_URL=
# 실제 인증에는 필요해요. openssl rand -base64 32로 생성해요. 빌드에는 없어도 돼요.
AUTH_SECRET=
# 브라우저에서 사용하는 앱 주소예요.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 각 제공자는 두 값을 모두 설정해야 활성화돼요. 둘 다 비우면 꺼져요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
